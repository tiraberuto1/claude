; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="酒伝童子絵巻 絵が動く最小プロトタイプ"
run/main_scene="res://scenes/prototype.tscn"
config/features=PackedStringArray("4.3")

[display]

window/size/viewport_width=2048
window/size/viewport_height=914
window/size/window_width_override=1280
window/size/window_height_override=571
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

environment/defaults/default_clear_color=Color(0.12, 0.1, 0.08, 1)
